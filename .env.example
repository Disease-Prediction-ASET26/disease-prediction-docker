# Copy to .env. Keep .env local; never commit generated values.
POSTGRES_DB=disease_prediction
POSTGRES_USER=disease_prediction
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5433
LOCAL_UID=1000
LOCAL_GID=1000

# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Optional local port and model controls.
AI_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173
AI_THREADS=2
AI_LOG_LEVEL=debug

# SonarQube is optional. Replace the local password before sharing this setup.
SONAR_DB_PASSWORD=change-this-sonar-password
SONAR_TOKEN=
SONAR_REPO=disease-prediction-ai
